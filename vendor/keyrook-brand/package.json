{
  "name": "@keyrook/brand",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Keyrook's identity for every product: tokens, the crow, each product's mark, the wordmark, icons, motion.",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./brand.css": "./brand.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "render": "node scripts/render-brand.mjs",
    "check": "node scripts/render-brand.mjs --check",
    "typecheck": "tsc --pretty",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  }
}
