{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "./.tsbuild",
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@authx/core": [
        "../../packages/core/src/index.ts"
      ],
      "@authx/service/*": [
        "../../packages/service/src/*"
      ],
      "@authx/ui/*": [
        "../../packages/ui/src/*"
      ],
      "@keyrook/account": [
        "../../vendor/keyrook-account/src/index.ts"
      ],
      "@keyrook/brand": [
        "../../vendor/keyrook-brand/src/index.ts"
      ],
      "~/*": [
        "./src/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "rootDir": "../.."
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "dev/**/*.ts",
    "test/**/*.ts",
    "../../vendor/keyrook-brand/src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../vendor/keyrook-account"
    },
    {
      "path": "../../packages/core"
    },
    {
      "path": "../../packages/ui"
    },
    {
      "path": "../../packages/service"
    }
  ]
}
